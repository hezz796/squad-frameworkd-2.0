{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/squad/project-state.schema.json",
  "title": "Squad Project State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "workflow",
    "tasks",
    "decisions",
    "active_work",
    "last_verified",
    "blockers",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "goal",
        "stack_status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "stack_status": {
          "type": "string",
          "enum": [
            "undecided",
            "proposed",
            "selected"
          ]
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "status",
        "current_task_id",
        "next_action"
      ],
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "intake",
            "requirements",
            "architecture",
            "implementation",
            "verification",
            "release",
            "maintenance"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "ready",
            "in_progress",
            "blocked",
            "complete"
          ]
        },
        "current_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_action": {
          "type": "string"
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "blocked",
              "in_review",
              "done"
            ]
          },
          "path": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "active_work": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "kind",
          "reference",
          "status"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "session",
              "worktree",
              "background_process"
            ]
          },
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "waiting",
              "completed",
              "failed",
              "unknown"
            ]
          }
        }
      }
    },
    "last_verified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "checks",
        "notes"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "result",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "not_run",
                  "not_applicable"
                ]
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "owner",
          "required_action"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "required_action": {
            "type": "string"
          }
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}